# ---------------------------------------------------------------
# GVP website environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env`.
# ---------------------------------------------------------------

# Public URL of the site (used for metadata, sitemap and email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Colour palette: "maroon-blush" (default), "indigo-lime", "navy-saffron", "passport-ink" (emerald, parchment, copper)
# or "diplomatic-oxblood" (oxblood, bone, celadon)
NEXT_PUBLIC_THEME="maroon-blush"

# Home-page-only preview: links and buttons are clickable but don't navigate.
# Off by default (all pages linked). Set to "true" to show only the home page.
NEXT_PUBLIC_HOME_ONLY="false"

# Team and Experience pages are hidden (menus, sitemap, 404) until their content
# is confirmed. Set to "true" to preview them.
NEXT_PUBLIC_SHOW_DRAFT_PAGES="false"

# Show [bracketed] placeholder text highlighted in copper on the site.
# Set to "false" before going live once every placeholder is replaced.
NEXT_PUBLIC_SHOW_PLACEHOLDERS="true"

# MongoDB connection string. Prisma needs MongoDB to run as a replica set
# (MongoDB Atlas works out of the box).
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/gvp?retryWrites=true&w=majority"

# SMTP (email delivery)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER="no-reply@example.com"
SMTP_PASS="change-me"

# Sender shown on outgoing emails
MAIL_FROM="GVP Government Team <no-reply@example.com>"

# Where new enquiries are delivered (comma-separate multiple addresses)
ENQUIRY_TO="government@example.com"

# Send an acknowledgement email to the person who submitted the form
SEND_ACKNOWLEDGEMENT="true"
